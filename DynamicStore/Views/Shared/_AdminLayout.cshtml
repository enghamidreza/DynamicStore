@* Views/Shared/_AdminLayout.cshtml *@
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - پنل مدیریت داینامیک‌استور</title>

    <!-- Bootstrap 5 RTL & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-bg: #1e293b;
            --sidebar-hover: #334155;
            --sidebar-active: #0d6efd;
        }

        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Tahoma, sans-serif;
            background-color: #f8fafc;
            min-height: 100vh;
        }

        /* Sidebar Styling */
        .admin-sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            background-color: var(--sidebar-bg);
            color: #e2e8f0;
            position: fixed;
            top: 0;
            right: 0;
            z-index: 1020;
            transition: all 0.3s ease;
        }

        .admin-sidebar .brand {
            padding: 1.25rem 1.5rem;
            font-size: 1.2rem;
            font-weight: 700;
            color: #fff;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .admin-nav {
            padding: 1rem 0;
        }

        .admin-nav .nav-link {
            color: #94a3b8;
            padding: 0.75rem 1.5rem;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.2s;
        }

        .admin-nav .nav-link:hover {
            color: #fff;
            background-color: var(--sidebar-hover);
        }

        .admin-nav .nav-link.active {
            color: #fff;
            background-color: var(--sidebar-active);
            font-weight: 600;
        }

        /* Main Content Wrapper */
        .admin-main-wrapper {
            margin-right: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
        }

        /* Top Navbar */
        .admin-topbar {
            height: 64px;
            background-color: #fff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1010;
        }

        .admin-content {
            padding: 2rem;
            flex: 1;
        }

        /* Responsive adjustments */
        @@media (max-width: 992px) {
            .admin-sidebar {
                right: -260px;
            }
            .admin-sidebar.show {
                right: 0;
            }
            .admin-main-wrapper {
                margin-right: 0;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Sidebar -->
    <aside class="admin-sidebar" id="adminSidebar">
        <div class="brand">
            <i class="bi bi-shop fs-4 text-primary"></i>
            <span>DynamicStore</span>
        </div>

        <nav class="admin-nav nav flex-column">
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")"
               asp-controller="Admin" asp-action="Index">
                <i class="bi bi-grid-fill"></i>
                <span>داشبورد</span>
            </a>

            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")"
               asp-controller="Products" asp-action="Index">
                <i class="bi bi-box-seam-fill"></i>
                <span>مدیریت محصولات</span>
            </a>

            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")"
               asp-controller="Category" asp-action="Index">
                <i class="bi bi-diagram-3-fill"></i>
                <span>مدیریت دسته‌بندی‌ها</span>
            </a>

            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")"
               asp-controller="AdminOrders" asp-action="Index">
                <i class="bi bi-receipt-cutoff"></i>
                <span>مدیریت سفارش‌ها</span>
            </a>

            <hr class="mx-3 my-3 text-secondary" />

            <a class="nav-link" asp-controller="Shop" asp-action="Index" target="_blank">
                <i class="bi bi-box-arrow-up-right"></i>
                <span>مشاهده فروشگاه</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content Area -->
    <div class="admin-main-wrapper">
        <!-- Topbar -->
        <header class="admin-topbar shadow-sm">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-secondary d-lg-none" type="button" id="sidebarToggle">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <h5 class="m-0 text-secondary fw-semibold">پنل مدیریت</h5>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 border" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle fs-5 text-primary"></i>
                        <span>مدیر سیستم</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-start text-end shadow-sm">
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                    <i class="bi bi-box-arrow-left"></i>
                                    خروج از حساب
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Body Render -->
        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const toggleBtn = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('adminSidebar');
        if (toggleBtn && sidebar) {
            toggleBtn.addEventListener('click', () => {
                sidebar.classList.toggle('show');
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
