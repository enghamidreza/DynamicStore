@{
    ViewData["Title"] = "صفحه اصلی";
}

<!-- Hero Section -->
<div class="p-5 mb-4 bg-white rounded-3 shadow-sm border text-center">
    <div class="container-fluid py-4">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-3 px-3 py-2 rounded-pill">
            نسخه پیشرفته تحت .NET 9
        </span>
        <h1 class="display-6 fw-bold text-dark mb-3">فروشگاه آنلاین با سیستم ویژگی‌های داینامیک</h1>
        <p class="col-md-8 mx-auto fs-6 text-muted mb-4">
            امکان تعریف ویژگی‌های متغیر به ازای هر دسته‌بندی (EAV Pattern)، آپلود و مدیریت تصاویر، جستجو و فیلتر پیشرفته بر اساس قیمت و دسته.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-cart3 me-1"></i> مشاهده کاتالوگ فروشگاه
            </a>
            @if (User.Identity == null || !User.Identity.IsAuthenticated)
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-lg px-4">
                    ورود به پنل مدیریت
                </a>
            }
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="row g-4 text-center">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-4">
            <div class="text-primary mb-3">
                <i class="bi bi-sliders2 fs-1"></i>
            </div>
            <h5 class="fw-bold">ویژگی‌های پویا</h5>
            <p class="text-muted small mb-0">قابلیت تعریف فیلدهای دلخواه متناسب با هر نوع کالا در پایگاه داده.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-4">
            <div class="text-success mb-3">
                <i class="bi bi-search fs-1"></i>
            </div>
            <h5 class="fw-bold">جستجو و فیلترینگ</h5>
            <p class="text-muted small mb-0">فیلتر بلادرنگ کالاها بر اساس بازه قیمت، دسته‌بندی و مرتب‌سازی دلخواه.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-4">
            <div class="text-warning mb-3">
                <i class="bi bi-shield-lock fs-1"></i>
            </div>
            <h5 class="fw-bold">مدیریت امن</h5>
            <p class="text-muted small mb-0">احراز هویت کوکی-بیس (Cookie Authentication) جهت دسترسی ادمین.</p>
        </div>
    </div>
</div>
