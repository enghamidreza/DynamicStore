@model IEnumerable<DynamicStore.Models.Order>

@{
    ViewData["Title"] = "مدیریت سفارشات";
    Layout = "_AdminLayout"; // یا هر لیوت دیگری که برای پنل ادمین دارید
}

<div class="container mt-4" dir="rtl">
    <h1 class="mb-4">لیست سفارشات ثبت شده</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>شماره سفارش</th>
                                <th>نام مشتری</th>
                                <th>تاریخ ثبت</th>
                                <th>مبلغ کل (تومان)</th>
                                <th>وضعیت پرداخت</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>@order.Id</td>
                                    <td>@order.CustomerName</td>
                                    <td>@order.OrderDate.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>@order.TotalAmount.ToString("N0")</td>
                                    <td>
                                        @if (order.IsPaid)
                                        {
                                            <span class="badge bg-success">پرداخت شده</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">در انتظار پرداخت</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye-fill me-1"></i> مشاهده جزئیات
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="bi bi-inbox-fill fs-3 d-block mb-2"></i>
                    هنوز هیچ سفارشی در سیستم ثبت نشده است.
                </div>
            }
        </div>
    </div>
</div>
