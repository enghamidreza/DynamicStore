@model DynamicStore.Models.ProductEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "عنوان صفحه";
}

@{
    ViewData["Title"] = $"ویرایش محصول - {Model.Name}";
    var categories = ViewBag.Categories as List<DynamicStore.Models.Category> ?? new List<DynamicStore.Models.Category>();
}

<div class="container py-4" dir="rtl">
    <!-- هدر و مسیر راهنما (Breadcrumb) -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="bi bi-pencil-square text-warning me-2"></i>ویرایش محصول: <span class="text-primary">@Model.Name</span>
            </h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">مدیریت محصولات</a></li>
                    <li class="breadcrumb-item active" aria-current="page">ویرایش کالا (کد: #@Model.Id)</li>
                </ol>
            </nav>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mt-2 mt-sm-0">
            <i class="bi bi-arrow-right me-1"></i>بازگشت به لیست
        </a>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" novalidate id="editProductForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExistingImageUrl" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 mb-4" role="alert"></div>

        <div class="row g-4">
            <!-- ستون سمت راست: مشخصات پایه و ویژگی‌های داینامیک -->
            <div class="col-lg-8">

                <!-- بخش ۱: اطلاعات پایه محصول -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-info-circle text-primary me-1"></i> مشخصات اصلی کالا
                        </h6>
                        <span class="badge bg-light text-dark border">شناسه: #@Model.Id</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <!-- نام محصول -->
                            <div class="col-12">
                                <label asp-for="Name" class="form-label fw-semibold">نام و عنوان محصول <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control form-control-lg fs-6" placeholder="عنوان کامل محصول را وارد کنید" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <!-- دسته‌بندی -->
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-semibold">دسته‌بندی <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-folder2"></i></span>
                                    <select asp-for="CategoryId" class="form-select" id="categorySelect">
                                        <option value="">-- انتخاب دسته‌بندی --</option>
                                        @foreach (var cat in categories)
                                        {
                                            <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId)">
                                                @cat.Title
                                            </option>
                                        }
                                    </select>
                                </div>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                                <div class="form-text small text-muted">تغییر دسته، فیلدهای ویژگی را بازنشانی می‌کند.</div>
                            </div>

                            <!-- قیمت -->
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-semibold">قیمت فروش <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input asp-for="Price" type="number" step="any" class="form-control" id="productPriceInput" placeholder="0" />
                                    <span class="input-group-text bg-light text-muted">تومان</span>
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                                <div id="priceHelper" class="form-text small text-success fw-bold mt-1"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- بخش ۲: مشخصات فنی داینامیک (EAV) -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-sliders text-warning me-1"></i> ویژگی‌های اختصاصی دسته
                        </h6>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">مقادیر ذخیره‌شده</span>
                    </div>
                    <div class="card-body p-4">
                        <!-- نگهدارنده استاندارد ویژگی‌ها مطابق کد JS شما -->
                        <div id="attributesContainer"
                             class="p-3 bg-light rounded-3 border"
                             data-initial-values='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AttributeValues))'>

                            <div class="text-center text-muted py-4" id="loadingAttributes">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                <span>در حال بارگذاری ویژگی‌های ذخیره‌شده محصول...</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ستون سمت چپ: مدیریت تصویر و دکمه‌های اقدام -->
            <div class="col-lg-4">

                <div class="card border-0 shadow-sm rounded-3 mb-4 sticky-top" style="top: 1.5rem; z-index: 10;">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-image text-success me-1"></i> مدیریت تصویر محصول
                        </h6>
                    </div>
                    <div class="card-body p-4 text-center">

                        <!-- نمایش تصویر فعلی -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted d-block text-start mb-2">تصویر فعلی در سیستم:</label>
                            @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                            {
                                <div class="p-2 border rounded-3 bg-light d-inline-block position-relative w-100">
                                    <img src="~/images/products/@Model.ExistingImageUrl"
                                         alt="@Model.Name"
                                         class="img-fluid rounded shadow-sm"
                                         style="max-height: 180px; object-fit: contain;" />
                                    <span class="badge bg-secondary position-absolute bottom-0 start-50 translate-middle-x mb-2 shadow-sm">
                                        تصویر فعال
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="p-4 border rounded-3 bg-light text-muted small">
                                    <i class="bi bi-image-alt fs-2 d-block mb-1 text-secondary"></i>
                                    تصویری برای این محصول ثبت نشده است.
                                </div>
                            }
                        </div>

                        <!-- باکس پیش‌نمایش تصویر جدید (در صورت انتخاب فایل) -->
                        <div id="newImagePreviewBox" class="mb-3 d-none">
                            <label class="form-label small fw-semibold text-success d-block text-start mb-2">
                                <i class="bi bi-check-circle me-1"></i>پیش‌نمایش تصویر جدید جایگزین:
                            </label>
                            <div class="p-2 border border-success border-2 rounded-3 bg-light">
                                <img id="newImagePreview" src="#" alt="پیش‌نمایش تصویر جدید" class="img-fluid rounded" style="max-height: 160px; object-fit: contain;" />
                            </div>
                        </div>

                        <!-- فیلد بارگذاری تصویر جدید -->
                        <div class="text-start mt-3">
                            <label asp-for="ImageFile" class="form-label small fw-semibold">تغییر یا بارگذاری تصویر جدید</label>
                            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" id="imageFileInput" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                            <div class="form-text small text-muted">در صورت عدم انتخاب، تصویر فعلی باقی خواهد ماند.</div>
                        </div>

                        <hr class="my-4">

                        <!-- دکمه‌های فرم -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg fw-bold shadow-sm text-dark">
                                <i class="bi bi-check-circle me-1"></i> ذخیره تغییرات
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                انصراف و بازگشت
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/product-edit.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // ۱. پیش‌نمایش زنده تصویر انتخابی جدید
            const fileInput = document.getElementById('imageFileInput');
            const previewBox = document.getElementById('newImagePreviewBox');
            const previewImg = document.getElementById('newImagePreview');

            if (fileInput && previewBox && previewImg) {
                fileInput.addEventListener('change', function (e) {
                    const file = e.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (event) {
                            previewImg.src = event.target.result;
                            previewBox.classList.remove('d-none');
                        };
                        reader.readAsDataURL(file);
                    } else {
                        previewImg.src = '#';
                        previewBox.classList.add('d-none');
                    }
                });
            }

            // ۲. نمایش فرمت خوانای قیمت به تومان (هنگام لود و حین تغییر)
            const priceInput = document.getElementById('productPriceInput');
            const priceHelper = document.getElementById('priceHelper');

            function updatePriceHelper() {
                if (!priceInput || !priceHelper) return;
                const val = parseFloat(priceInput.value);
                if (!isNaN(val) && val > 0) {
                    priceHelper.textContent = 'معادل: ' + val.toLocaleString('fa-IR') + ' تومان';
                } else {
                    priceHelper.textContent = '';
                }
            }

            if (priceInput) {
                updatePriceHelper(); // نمایش اولیه به هنگام بارگذاری صفحه
                priceInput.addEventListener('input', updatePriceHelper);
            }
        });
    </script>
}
