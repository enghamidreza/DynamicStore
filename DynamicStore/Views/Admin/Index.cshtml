@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "داشبورد مدیریت";

    decimal totalRevenue = ViewBag.TotalRevenue != null ? (decimal)ViewBag.TotalRevenue : 0m;
    var recentOrders = ViewBag.RecentOrders as IEnumerable<Order>;
}
<div class="row g-3 mb-4">
    <!-- کارت درآمد کل -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-muted small">فروش کل (تومان)</span>
                    <h4 class="fw-bold mb-0 text-success mt-1">@totalRevenue.ToString("N0")</h4>
                </div>
                <div class="rounded-circle bg-success-subtle p-3 text-success">
                    <i class="bi bi-cash-coin fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- کارت تعداد سفارشات -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-muted small">تعداد سفارشات</span>
                    <h4 class="fw-bold mb-0 text-primary mt-1">@ViewBag.TotalOrders</h4>
                </div>
                <div class="rounded-circle bg-primary-subtle p-3 text-primary">
                    <i class="bi bi-cart-check fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- کارت تعداد محصولات -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-muted small">تعداد کالاها</span>
                    <h4 class="fw-bold mb-0 text-info mt-1">@ViewBag.TotalProducts</h4>
                </div>
                <div class="rounded-circle bg-info-subtle p-3 text-info">
                    <i class="bi bi-box-seam fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- کارت دسته‌بندی‌ها -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-muted small">دسته‌بندی‌ها</span>
                    <h4 class="fw-bold mb-0 text-warning mt-1">@ViewBag.TotalCategories</h4>
                </div>
                <div class="rounded-circle bg-warning-subtle p-3 text-warning">
                    <i class="bi bi-tags fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- جدول آخرین سفارش‌ها در داشبورد -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-clock-history text-primary me-2"></i>آخرین سفارش‌های ثبت‌شده
        </h5>
        <a asp-controller="AdminOrders" asp-action="Index" class="btn btn-sm btn-outline-primary">
            مشاهده همه سفارشات
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="table-light">
                    <tr>
                        <th class="py-3">شناسه</th>
                        <th class="py-3 text-start ps-3">نام مشتری</th>
                        <th class="py-3">تاریخ</th>
                        <th class="py-3">مبلغ (تومان)</th>
                        <th class="py-3">وضعیت</th>
                        <th class="py-3">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentOrders != null && recentOrders.Any())
                    {
                        foreach (var order in recentOrders)
                        {
                            <tr>
                                <td><span class="badge bg-light text-secondary border">#@order.Id</span></td>
                                <td class="text-start ps-3 fw-semibold">@order.CustomerName</td>
                                <td class="text-muted small">@order.OrderDate.ToString("yyyy/MM/dd HH:mm")</td>
                                <td class="fw-bold text-success">@order.TotalAmount.ToString("N0")</td>
                                <td>
                                    @if (order.IsPaid)
                                    {
                                        <span class="badge bg-success-subtle text-success border">پرداخت شده</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border">در انتظار پرداخت</span>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-primary px-2 py-1">
                                        جزئیات
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">سفارشی ثبت نشده است.</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>
