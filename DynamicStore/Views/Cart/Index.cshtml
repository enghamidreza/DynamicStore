@using DynamicStore.ViewModel
@model CartViewModels
@{
    ViewData["Title"] = "سبد خرید شما";
}

<div class="container py-4">
    <div class="row align-items-center mb-4">
        <div class="col">
            <h4 class="fw-bold mb-0 text-dark">
                <i class="bi bi-cart3 text-primary me-2"></i>سبد خرید شما
            </h4>
        </div>
        @if (Model.Items.Any())
        {
            <div class="col-auto">
                <form asp-action="Clear" method="post" onsubmit="return confirm('آیا از خالی کردن کل سبد خرید اطمینان دارید؟');">
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-trash3 me-1"></i>خالی کردن سبد
                    </button>
                </form>
            </div>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>@TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Items.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-cart-x text-muted display-1"></i>
                <h5 class="fw-bold text-secondary mt-3">سبد خرید شما خالی است!</h5>
                <p class="text-muted small">می‌توانید برای مشاهده محصولات به فروشگاه بازگردید.</p>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-primary px-4 mt-2">
                    <i class="bi bi-shop me-1"></i>مشاهده محصولات
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- ستون لیست اقلام سبد -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3 py-3">محصول</th>
                                    <th class="py-3">قیمت واحد</th>
                                    <th class="py-3" style="width: 140px;">تعداد</th>
                                    <th class="py-3">مجموع</th>
                                    <th class="py-3 text-center" style="width: 60px;">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="ps-3 py-3">
                                            <div class="d-flex align-items-center">
                                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : $"/images/products/{item.ImageUrl}")"
                                                     alt="@item.Title"
                                                     class="rounded border me-3 object-fit-cover"
                                                     style="width: 60px; height: 60px;" />
                                                <div>
                                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId"
                                                       class="text-decoration-none fw-semibold text-dark hover-primary d-block">
                                                        @item.Title
                                                    </a>
                                                    <span class="text-muted small">کد کالا: #@item.ProductId</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <span class="fw-semibold">@item.Price.ToString("N0")</span>
                                            <span class="text-muted small">تومان</span>
                                        </td>
                                        <td class="py-3">
                                            <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-1">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="number" name="count" value="@item.Quantity" min="1" max="99"
                                                       class="form-control form-control-sm text-center" style="width: 65px;" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="به‌روزرسانی تعداد">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                </button>
                                            </form>
                                        </td>
                                        <td class="py-3">
                                            <span class="fw-bold text-primary">@item.SubTotal.ToString("N0")</span>
                                            <span class="text-muted small">تومان</span>
                                        </td>
                                        <td class="py-3 text-center">
                                            <form asp-action="Remove" method="post">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="btn btn-sm text-danger border-0 p-1" title="حذف کالا">
                                                    <i class="bi bi-trash3-fill"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ستون فاکتور و پرداخت نهایی -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-dark mb-3">خلاصه فاکتور</h6>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">تعداد کل اقلام:</span>
                            <span class="fw-semibold">@Model.TotalItemsCount عدد</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">مبلغ کل کالاها:</span>
                            <span class="fw-semibold">@Model.TotalAmount.ToString("N0") تومان</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 text-success">
                            <span>هزینه ارسال:</span>
                            <span class="fw-semibold">رایگان</span>
                        </div>

                        <hr class="my-3" />

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fw-bold text-dark fs-6">مبلغ قابل پرداخت:</span>
                            <span class="fw-bold text-primary fs-5">@Model.TotalAmount.ToString("N0") <small class="text-muted fs-6">تومان</small></span>
                        </div>

                        <!-- دکمه ورود به مرحله فاز ۷ (Checkout) -->
                        <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary w-100 py-2 fw-semibold">
                            ادامه فرآیند خرید <i class="bi bi-arrow-left ms-1"></i>
                        </a>

                        <a asp-controller="Shop" asp-action="Index" class="btn btn-link text-decoration-none text-muted w-100 mt-2 small text-center">
                            بازگشت به ادامه خرید
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
