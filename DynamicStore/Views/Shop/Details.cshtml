@model DynamicStore.Models.Product

@{
    ViewData["Title"] = Model.Title;
}

<style>
    /* قاب و استایل تصویر کالا */
    .product-gallery-box {
        background-color: #fff;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 1rem;
        padding: 1.5rem;
        position: relative;
        text-align: center;
    }

    .product-main-img {
        max-height: 380px;
        max-width: 100%;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .product-gallery-box:hover .product-main-img {
        transform: scale(1.03);
    }

    /* جعبه خرید (Buy Box) */
    .buy-box {
        border: 1px solid rgba(13, 110, 253, 0.18);
        background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    }

    /* نشان‌های اعتماد و مزایا */
    .trust-badge-item {
        transition: transform 0.2s ease;
    }

        .trust-badge-item:hover {
            transform: translateY(-2px);
        }

    /* جدول مشخصات */
    .spec-table th {
        background-color: #f8f9fa;
        color: #495057;
        font-weight: 600;
        width: 30%;
        border-bottom: 1px solid #eef0f3;
    }

    .spec-table td {
        border-bottom: 1px solid #eef0f3;
        color: #212529;
    }
</style>

<div class="container py-4" dir="rtl">

    <!-- مسیر راهنما (Breadcrumb) -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-white px-3 py-2 rounded-3 shadow-sm border small">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">
                    <i class="bi bi-house-door-fill text-primary me-1"></i> خانه
                </a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Shop" asp-action="Index" class="text-decoration-none text-muted">فروشگاه</a>
            </li>
            @if (Model.Category != null)
            {
                <li class="breadcrumb-item">
                    <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-decoration-none text-muted">
                        @Model.Category.Title
                    </a>
                </li>
            }
            <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <!-- بخش اصلی معرفی محصول (۳ ستونه در دسکتاپ) -->
    <div class="row g-4 mb-4">

        <!-- ستون ۱: تصویر محصول -->
        <div class="col-lg-4 col-md-5">
            <div class="product-gallery-box shadow-sm h-100 d-flex flex-column justify-content-center align-items-center">
                @if (Model.Category != null)
                {
                    <span class="position-absolute top-0 start-0 m-3 badge bg-light text-secondary border shadow-xs small">
                        <i class="bi bi-tag me-1"></i> @Model.Category.Title
                    </span>
                }

                @if (!string.IsNullOrEmpty(Model.ImageName))
                {
                    <img src="~/images/products/@Model.ImageName"
                         alt="@Model.Title"
                         class="product-main-img img-fluid" />
                }
                else
                {
                    <div class="text-muted text-center py-5">
                        <i class="bi bi-image fs-1 d-block opacity-25 mb-2"></i>
                        <span class="small">تصویری برای این کالا ثبت نشده است</span>
                    </div>
                }
            </div>
        </div>

        <!-- ستون ۲: مشخصات اصلی و توضیحات -->
        <div class="col-lg-5 col-md-7">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white d-flex flex-column justify-content-between">
                <div>
                    <!-- عنوان و شناسه -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">
                            کالای اصل
                        </span>
                        <span class="text-muted small">کد محصول: @Model.Id</span>
                    </div>

                    <h1 class="h4 fw-bold text-dark mb-3 lh-base">@Model.Title</h1>

                    <!-- دسته‌بندی با لینک سریع -->
                    @if (Model.Category != null)
                    {
                        <div class="mb-3 small">
                            <span class="text-muted">دسته‌بندی:</span>
                            <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-decoration-none fw-semibold text-primary ms-1">
                                @Model.Category.Title
                            </a>
                        </div>
                    }

                    <hr class="text-muted opacity-25 my-3">

                    <!-- توضیحات محصول -->
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark mb-2">
                                <i class="bi bi-card-text text-primary me-1"></i> معرفی و بررسی:
                            </h6>
                            <p class="text-secondary small lh-lg mb-0 text-justify" style="white-space: pre-line;">
                                @Model.Description
                            </p>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small fst-italic mb-4">
                            توضیحات تکمیلی برای این محصول درج نشده است.
                        </p>
                    }
                </div>

                <!-- نشان‌های مزایای فروشگاه (Trust Badges) -->
                <div class="pt-3 border-top">
                    <div class="row row-cols-2 g-2 text-center">
                        <div class="col">
                            <div class="trust-badge-item p-2 bg-light rounded-3">
                                <i class="bi bi-shield-check text-success fs-5 d-block mb-1"></i>
                                <span class="small text-muted fw-semibold" style="font-size: 0.75rem;">ضمانت اصالت کالا</span>
                            </div>
                        </div>
                        <div class="col">
                            <div class="trust-badge-item p-2 bg-light rounded-3">
                                <i class="bi bi-arrow-counterclockwise text-info fs-5 d-block mb-1"></i>
                                <span class="small text-muted fw-semibold" style="font-size: 0.75rem;">۷ روز تضمین بازگشت</span>
                            </div>
                        </div>
                        <div class="col">
                            <div class="trust-badge-item p-2 bg-light rounded-3">
                                <i class="bi bi-truck text-warning fs-5 d-block mb-1"></i>
                                <span class="small text-muted fw-semibold" style="font-size: 0.75rem;">تحویل سریع و مطمئن</span>
                            </div>
                        </div>
                        <div class="col">
                            <div class="trust-badge-item p-2 bg-light rounded-3">
                                <i class="bi bi-headset text-primary fs-5 d-block mb-1"></i>
                                <span class="small text-muted fw-semibold" style="font-size: 0.75rem;">پشتیبانی ۲۴ ساعته</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- ستون ۳: باکس خرید و اقدام (Buy Box) -->
        <div class="col-lg-3 col-md-12">
            <div class="card buy-box shadow-sm rounded-4 p-4 sticky-top" style="top: 1.5rem; z-index: 5;">

                <!-- وضعیت موجودی -->
                <div class="d-flex align-items-center text-success mb-3 small fw-bold">
                    <i class="bi bi-check-circle-fill me-2 fs-6"></i>
                    <span>موجود در انبار و آماده ارسال</span>
                </div>

                <hr class="text-muted opacity-25 my-2">

                <!-- قیمت کالا -->
                <div class="my-3">
                    <div class="text-muted small mb-1">قیمت نهایی محصول:</div>
                    <div class="d-flex align-items-baseline">
                        <span class="fs-2 fw-bold text-success me-2">@Model.Price.ToString("N0")</span>
                        <span class="text-muted small">تومان</span>
                    </div>
                </div>

                <!-- دکمه‌های اقدام -->
                <!-- دکمه‌های اقدام -->
                <div class="d-grid gap-2 mt-3">
                    <!-- تبدیل دکمه به فرم برای ارسال شناسه محصول به اکشن سبد خرید -->
                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 fw-bold py-2 shadow-sm d-flex align-items-center justify-content-center">
                            <i class="bi bi-cart-plus-fill me-2 fs-5"></i> افزودن به سبد خرید
                        </button>
                    </form>

                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3 py-2 small">
                        <i class="bi bi-arrow-right me-1"></i> بازگشت به فروشگاه
                    </a>
                </div>

                <div class="mt-4 pt-3 border-top text-center text-muted" style="font-size: 0.75rem;">
                    <i class="bi bi-info-circle me-1"></i> ارسال رایگان برای خریدهای بالای ۵۰۰ هزار تومان
                </div>
            </div>
        </div>

    </div>

    <!-- جدول مشخصات و ویژگی‌های پویا (EAV Attributes) -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mt-4 bg-white">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center">
            <i class="bi bi-sliders text-primary fs-5 me-2"></i>
            <h5 class="mb-0 fw-bold text-dark">مشخصات فنی و ویژگی‌ها</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.AttributeValues != null && Model.AttributeValues.Any())
            {
                <div class="table-responsive">
                    <table class="table spec-table mb-0 align-middle">
                        <tbody>
                            @foreach (var attr in Model.AttributeValues)
                            {
                                <tr>
                                    <th class="px-4 py-3">
                                        <i class="bi bi-dot text-primary fs-4 me-1 align-middle"></i>
                                        @attr.CategoryAttribute?.Title
                                    </th>
                                    <td class="px-4 py-3 fw-medium">
                                        @attr.Value
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-inbox fs-1 d-block opacity-50 mb-2"></i>
                    <span>هیچ مشخصه فنی داینامیکی برای این محصول ثبت نشده است.</span>
                </div>
            }
        </div>
    </div>

</div>
