@model DynamicStore.Models.ShopIndexViewModel

@{
    ViewData["Title"] = "ویترین فروشگاه";
    bool hasActiveFilter = !string.IsNullOrWhiteSpace(Model.Search) ||
                           Model.CategoryId.HasValue ||
                           Model.MinPrice.HasValue ||
                           Model.MaxPrice.HasValue ||
                           (!string.IsNullOrEmpty(Model.SortBy) && Model.SortBy != "newest");
}

<style>
    /* استایل‌های اختصاصی جهت جذابیت ویترین */
    .product-card {
        transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: 1px solid rgba(0, 0, 0, 0.07) !important;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08) !important;
            border-color: rgba(13, 110, 253, 0.3) !important;
        }

    .product-img-wrapper {
        height: 210px;
        position: relative;
        overflow: hidden;
        background-color: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem 0.5rem 0 0;
    }

    .product-img {
        max-height: 180px;
        max-width: 90%;
        object-fit: contain;
        transition: transform 0.35s ease;
    }

    .product-card:hover .product-img {
        transform: scale(1.06);
    }

    .product-title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.8rem;
        line-height: 1.4;
    }

    .sticky-filter {
        top: 1.5rem;
        z-index: 10;
    }
</style>

<div class="container py-4" dir="rtl">
    <!-- هدر صفحه و مسیر راهنما (Breadcrumb) -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="bi bi-shop text-primary me-2"></i>ویترین فروشگاه
            </h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">صفحه اصلی</a></li>
                    <li class="breadcrumb-item active" aria-current="page">همه محصولات</li>
                </ol>
            </nav>
        </div>

        <!-- دکمه بازکردن فیلترها در موبایل -->
        <button class="btn btn-outline-primary btn-sm d-lg-none mt-2 mt-sm-0" type="button" data-bs-toggle="collapse" data-bs-target="#filterSidebar">
            <i class="bi bi-funnel me-1"></i> فیلتر و جستجو
        </button>
    </div>

    <div class="row g-4">
        <!-- ستون سمت راست: فیلترها -->
        <div class="col-lg-3">
            <div class="collapse d-lg-block sticky-filter" id="filterSidebar">
                <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                    <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-6"><i class="bi bi-funnel-fill me-1"></i> فیلترهای پیشرفته</span>
                        @if (hasActiveFilter)
                        {
                            <a asp-action="Index" class="badge bg-white text-primary text-decoration-none shadow-sm" title="حذف تمام فیلترها">
                                پاک کردن
                            </a>
                        }
                    </div>

                    <div class="card-body p-3">
                        <form asp-controller="Shop" asp-action="Index" method="get">

                            <!-- ۱. جستجو -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-secondary">جستجو در عنوان یا متن</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light"><i class="bi bi-search text-muted"></i></span>
                                    <input type="text" name="search" value="@Model.Search"
                                           class="form-control" placeholder="نام محصول، برند...">
                                </div>
                            </div>

                            <!-- ۲. دسته‌بندی -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-secondary">دسته‌بندی کالا</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light"><i class="bi bi-folder2-open text-muted"></i></span>
                                    <select name="categoryId" class="form-select">
                                        <option value="">همه دسته‌بندی‌ها</option>
                                        @foreach (var cat in Model.Categories)
                                        {
                                            <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id ? "selected" : null)">
                                                @cat.Title
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <!-- ۳. مرتب‌سازی -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-secondary">مرتب‌سازی بر اساس</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light"><i class="bi bi-sort-down text-muted"></i></span>
                                    <select name="sortBy" class="form-select">
                                        <option value="newest" selected="@(Model.SortBy == "newest" ? "selected" : null)">جدیدترین کالاها</option>
                                        <option value="price_asc" selected="@(Model.SortBy == "price_asc" ? "selected" : null)">ارزان‌ترین</option>
                                        <option value="price_desc" selected="@(Model.SortBy == "price_desc" ? "selected" : null)">گران‌ترین</option>
                                    </select>
                                </div>
                            </div>

                            <hr class="text-muted my-3">

                            <!-- ۴. بازه قیمت -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-secondary mb-2">محدوده قیمت (تومان)</label>

                                <div class="mb-2">
                                    <span class="small text-muted d-block mb-1">از قیمت:</span>
                                    <input type="number" name="minPrice" value="@Model.MinPrice"
                                           step="any" class="form-control form-control-sm" placeholder="مثلاً: ۱۰۰,۰۰۰">
                                </div>

                                <div class="mb-2">
                                    <span class="small text-muted d-block mb-1">تا قیمت:</span>
                                    <input type="number" name="maxPrice" value="@Model.MaxPrice"
                                           step="any" class="form-control form-control-sm" placeholder="مثلاً: ۱۰,۰۰۰,۰۰۰">
                                </div>
                            </div>

                            <!-- دکمه‌ها -->
                            <div class="d-grid gap-2 pt-2">
                                <button type="submit" class="btn btn-primary btn-sm fw-bold shadow-sm">
                                    <i class="bi bi-check2-circle me-1"></i> اعمال فیلتر
                                </button>
                                @if (hasActiveFilter)
                                {
                                    <a asp-action="Index" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-x-circle me-1"></i> حذف همه فیلترها
                                    </a>
                                }
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- ستون سمت چپ: گرید محصولات -->
        <div class="col-lg-9">
            <!-- نوار آمار و فیلترهای فعال -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 p-3 bg-white border rounded-3 shadow-sm">
                <div class="d-flex align-items-center">
                    <span class="text-muted small me-2">نتایج یافت‌شده:</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 fw-bold px-2 py-1">
                        @Model.Products.Count کالا
                    </span>
                </div>

                @if (hasActiveFilter)
                {
                    <div class="d-flex flex-wrap gap-1 align-items-center mt-2 mt-sm-0">
                        <span class="text-muted small me-1">فیلترهای فعال:</span>
                        @if (!string.IsNullOrEmpty(Model.Search))
                        {
                            <span class="badge bg-light text-dark border">جستجو: @Model.Search</span>
                        }
                        @if (Model.CategoryId.HasValue)
                        {
                            var activeCat = Model.Categories.FirstOrDefault(c => c.Id == Model.CategoryId);
                            if (activeCat != null)
                            {
                                <span class="badge bg-light text-dark border">دسته: @activeCat.Title</span>
                            }
                        }
                        @if (Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
                        {
                            <span class="badge bg-light text-dark border">بازه قیمت</span>
                        }
                    </div>
                }
            </div>

            <!-- شبکه کارت‌های محصولات -->
            @if (Model.Products.Any())
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-xl-3 g-4">
                    @foreach (var product in Model.Products)
                    {
                        <div class="col">
                            <div class="card h-100 product-card rounded-3 overflow-hidden bg-white">

                                <!-- قاب تصویر با افکت شناور -->
                                <div class="product-img-wrapper">
                                    @if (!string.IsNullOrEmpty(product.ImageName))
                                    {
                                        <img src="~/images/products/@product.ImageName"
                                             class="product-img"
                                             alt="@product.Title"
                                             loading="lazy">
                                    }
                                    else
                                    {
                                        <div class="text-muted small text-center">
                                            <i class="bi bi-image fs-1 d-block text-secondary opacity-50 mb-1"></i>
                                            فاقد تصویر
                                        </div>
                                    }

                                    <!-- برچسب دسته‌بندی شناور روی تصویر -->
                                    <span class="position-absolute top-0 start-0 m-2 badge bg-white text-secondary shadow-sm border small fw-normal">
                                        @product.Category?.Title
                                    </span>
                                </div>

                                <!-- محتوای متنی کارت -->
                                <div class="card-body d-flex flex-column p-3">
                                    <h6 class="product-title fw-bold text-dark mb-3" title="@product.Title">
                                        @product.Title
                                    </h6>

                                    <!-- قیمت و دکمه مشاهده -->
                                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="text-muted" style="font-size: 0.75rem;">قیمت فروش:</div>
                                            <span class="fw-bold text-success fs-5">@product.Price.ToString("N0")</span>
                                            <span class="text-muted small">تومان</span>
                                        </div>
                                        <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm px-3 rounded-pill fw-semibold">
                                            مشاهده <i class="bi bi-chevron-left small ms-1"></i>
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- حالت بدون نتیجه (Empty State) حرفه‌ای -->
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light text-warning rounded-circle mx-auto mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-search fs-1"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">کالایی با این مشخصات یافت نشد!</h5>
                    <p class="text-muted small mb-4 mx-auto" style="max-width: 420px;">
                        عبارت جستجو شده یا محدودیت قیمت انتخاب‌شده محصولی را شامل نمی‌شود. پیشنهاد می‌کنیم فیلترها را حذف یا بازتر کنید.
                    </p>
                    <div>
                        <a asp-action="Index" class="btn btn-primary px-4 rounded-pill shadow-sm">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> نمایش تمام محصولات فروشگاه
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
