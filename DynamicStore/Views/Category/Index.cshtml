@model IEnumerable<Category>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "عنوان صفحه";
}

@{
    ViewData["Title"] = "مدیریت دسته‌بندی‌ها";
    var totalCount = Model?.Count() ?? 0;
}

<div class="card shadow-sm border-0 rounded-3">
    <!-- هدر کارت -->
    <div class="card-header bg-white py-3 border-bottom">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h4 class="mb-1 text-dark fw-bold">
                    <i class="bi bi-tags-fill text-primary me-2"></i>مدیریت دسته‌بندی‌ها
                </h4>
                <p class="text-muted small mb-0">تعریف، ویرایش سریع و حذف دسته‌بندی‌های کالا در سامانه</p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                    تعداد: @totalCount دسته
                </span>
                <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center">
                    <i class="bi bi-plus-lg me-1"></i> افزودن دسته جدید
                </a>
            </div>
        </div>

        @if (totalCount > 0)
        {
            <!-- فیلد جستجوی سریع بین سطرها -->
            <div class="row mt-3">
                <div class="col-md-4 col-sm-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="categoryQuickSearch" class="form-control bg-light border-start-0"
                               placeholder="جستجوی سریع در نام دسته‌ها..." />
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- بدنه کارت / جدول -->
    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <div class="mb-3 text-muted">
                    <i class="bi bi-folder-x" style="font-size: 3.5rem;"></i>
                </div>
                <h5 class="fw-bold text-secondary">هنوز هیچ دسته‌بندی‌ای ثبت نشده است!</h5>
                <p class="text-muted small mb-3">برای تخصیص محصول و ویژگی، ابتدا اولین دسته را اضافه کنید.</p>
                <a asp-action="Create" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> ایجاد اولین دسته‌بندی
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th style="width: 100px;" class="py-3 text-secondary small fw-bold">شناسه</th>
                            <th class="py-3 text-secondary small fw-bold text-start ps-4">عنوان دسته‌بندی</th>
                            <th style="width: 220px;" class="py-3 text-secondary small fw-bold">عملیات</th>
                        </tr>
                    </thead>
                    <tbody id="categoryTableBody">
                        @foreach (var item in Model)
                        {
                            <tr id="row-@item.Id">
                                <!-- ستون شناسه -->
                                <td>
                                    <span class="badge bg-light text-secondary border px-2 py-1">
                                        #@item.Id
                                    </span>
                                </td>

                                <!-- ستون عنوان -->
                                <td class="text-start ps-4">
                                    <span class="fw-semibold text-dark">
                                        @item.Title
                                    </span>
                                </td>

                                <!-- ستون دکمه‌ها -->
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning px-2 py-1" title="ویرایش کامل">
                                            <i class="bi bi-pencil-square me-1"></i>ویرایش
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger px-2 py-1" onclick="deleteCategory(@item.Id)" title="حذف">
                                            <i class="bi bi-trash3 me-1"></i>حذف
                                        </button>
                                    </div>
                                </td>


                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
@section Scripts {
    <script src="~/js/category-inline.js" asp-append-version="true"></script>
    <script>
        // اسکریپت فیلتر لحظه‌ای جدول با جاوااسکریپت استاندارد (بدون نیاز به jQuery)
        document.addEventListener("DOMContentLoaded", function () {
            var searchInput = document.getElementById("categoryQuickSearch");
            if (searchInput) {
                searchInput.addEventListener("keyup", function () {
                    var filter = this.value.toLowerCase().trim();
                    var rows = document.querySelectorAll("#categoryTableBody tr");

                    rows.forEach(function (row) {
                        var text = row.textContent || row.innerText;
                        if (text.toLowerCase().indexOf(filter) > -1) {
                            row.style.display = "";
                        } else {
                            row.style.display = "none";
                        }
                    });
                });
            }
        });
    </script>
}

